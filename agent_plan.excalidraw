      "seed": 1919143834,
      "version": 955,
      "versionNonce": 2089951302,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787572999783,
      "link": null,
      "locked": false,
      "text": "Uses specialized agents to generate ideas, and compiles the best itinerary \nfrom those. When planning routes, the walking route is preferred \nin culturally significant or beautiful areas, and for less than 30 min walking \ntime. Otherwise, public transport is assumed unless stated in the query. \n1/4 of budget is given to Agent Foodie, and 3/8 to Agent Events and \nAgent Sights, each.",
      "fontSize": 13.520262835124267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses specialized agents to generate ideas, and compiles the best itinerary \nfrom those. When planning routes, the walking route is preferred \nin culturally significant or beautiful areas, and for less than 30 min walking \ntime. Otherwise, public transport is assumed unless stated in the query. \n1/4 of budget is given to Agent Foodie, and 3/8 to Agent Events and \nAgent Sights, each.",
      "autoResize": true,
      "lineHeight": 1.25
    },
